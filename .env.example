# ---------------------------------------------------------------------------
# Akredia · contoh konfigurasi untuk hosting cPanel (Laravel 13 + MySQL 8)
# Salin menjadi .env lalu sesuaikan. Nilai yang mengandung # atau spasi WAJIB
# diberi tanda kutip, misalnya DB_PASSWORD="sandi#rahasia".
# ---------------------------------------------------------------------------
APP_NAME=Akredia
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://akredia.domainanda.ac.id
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Database MySQL 8 (cPanel › MySQL Databases). Nama diawali akun cPanel.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=userku_akredia
DB_USERNAME=userku_akredia
DB_PASSWORD="ganti-dengan-sandi-database"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Hapus baris ini bila situs belum memakai HTTPS.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Email untuk pengingat tenggat dan ringkasan mingguan (cPanel › Email Accounts).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.domainanda.ac.id
MAIL_PORT=465
MAIL_USERNAME=akredia@domainanda.ac.id
MAIL_PASSWORD="ganti-dengan-sandi-email"
MAIL_FROM_ADDRESS="akredia@domainanda.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Pengaturan Akredia
# ---------------------------------------------------------------------------
# Administrator platform pertama, dibuat saat "php artisan migrate --seed".
# Kosongkan AKREDIA_ADMIN_PASSWORD lagi setelah instalasi selesai.
AKREDIA_ADMIN_EMAIL=admin@domainanda.ac.id
AKREDIA_ADMIN_PASSWORD="SandiSementara#2026"

# Wajibkan MFA (Google/Microsoft Authenticator) untuk Admin, Manajer, Pimpinan.
AKREDIA_MFA_REQUIRED=false

# Batas kata per sub-indikator LED dan ukuran unggahan bukti (KB).
AKREDIA_WORD_LIMIT=1500
AKREDIA_UPLOAD_MAX_KB=25600

# Data contoh Universitas Nusantara Mandiri (fiktif). false untuk pemakaian sungguhan.
AKREDIA_DEMO=false
AKREDIA_DEMO_PASSWORD="Demo#2026akredia"

# Asisten AI untuk reviu narasi LED (opsional). Kosongkan untuk menonaktifkan;
# pemeriksaan lokal (batas kata, kata kunci, sitasi) tetap berjalan.
AKREDIA_AI_KEY=
AKREDIA_AI_MODEL=claude-opus-5-5

# Hari pengiriman ringkasan mingguan ke pimpinan (monday ... sunday).
AKREDIA_WEEKLY_REPORT_DAY=monday
