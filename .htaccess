# Pengaman bila folder program terlanjur diletakkan di public_html:
# semua permintaan diarahkan ke folder public, berkas sensitif ditolak.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(\.env|composer\.(json|lock)|artisan|vendor/|storage/|database/|bootstrap/|config/|routes/|app/|tests/) - [F,L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
